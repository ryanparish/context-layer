// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum ConnectionAuthType {
  OAUTH2
  API_KEY
  BASIC
}

enum RunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  secrets     Secret[]
  connections Connection[]
  statements  XapiStatement[]
  workflows   Workflow[]
  xapiVerbs   XapiVerb[]
  xapiUris    XapiUri[]
  storylineBridges StorylineBridge[]
  uriTemplates UriTemplate[]
  statementPlans XapiStatementPlan[]
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  role         UserRole  @default(MEMBER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Secret {
  id         String   @id @default(cuid())
  tenantId   String
  label      String
  cipherText String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connections Connection[]

  @@index([tenantId])
}

model Connection {
  id         String             @id @default(cuid())
  tenantId   String
  name       String
  type       String
  authType   ConnectionAuthType
  secretId   String?
  status     String             @default("DISCONNECTED")
  lastSyncAt DateTime?
  syncEnabled Boolean           @default(false)
  syncCron    String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  secret Secret? @relation(fields: [secretId], references: [id], onDelete: SetNull)
  runs   ConnectorRun[]
  storylineBridges StorylineBridge[]

  @@index([tenantId])
  @@index([tenantId, type])
}

model XapiVerb {
  id        String   @id @default(cuid())
  tenantId  String
  iri       String
  display   String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, iri])
  @@index([tenantId])
}

model XapiUri {
  id        String   @id @default(cuid())
  tenantId  String
  iri       String
  label     String
  kind      String   @default("CUSTOM")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, iri])
  @@index([tenantId, kind])
}

model StorylineBridge {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  connectionId    String
  tokenHash       String
  allowedOrigins  String[] @default([])
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  variables  StorylineVariable[]

  @@index([tenantId])
  @@index([connectionId])
}

model StorylineVariable {
  id            String   @id @default(cuid())
  bridgeId      String
  key           String
  direction     String   // IN or OUT
  storylineName String
  jsonPath      String?
  createdAt     DateTime @default(now())

  bridge StorylineBridge @relation(fields: [bridgeId], references: [id], onDelete: Cascade)

  @@unique([bridgeId, key])
  @@index([bridgeId])
}

model UriTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  category    String?
  sourceType  String   @default("ANY")
  baseUrl     String
  segments    Json
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
  @@index([tenantId, sourceType])
}

model XapiStatementPlan {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  uriTemplateId String?
  mapping       Json
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@index([tenantId, uriTemplateId])
}

model ConnectorRun {
  id           String   @id @default(cuid())
  tenantId     String
  connectionId String
  status       RunStatus @default(QUEUED)
  startedAt    DateTime?
  finishedAt   DateTime?
  error        String?
  createdAt    DateTime  @default(now())

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([connectionId, createdAt])
}

model XapiStatement {
  id        String   @id @default(cuid())
  tenantId  String
  statement Json

  actorMbox String?
  verbId    String?
  objectId  String?
  occurredAt DateTime?

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, verbId])
  @@index([tenantId, actorMbox])
  @@index([tenantId, objectId])
}

model Workflow {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  enabled   Boolean  @default(true)
  trigger   Json
  action    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   WorkflowRun[]

  @@index([tenantId])
}

model WorkflowRun {
  id         String    @id @default(cuid())
  tenantId   String
  workflowId String
  status     RunStatus @default(QUEUED)
  startedAt  DateTime?
  finishedAt DateTime?
  error      String?
  log        Json?
  createdAt  DateTime  @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([workflowId, createdAt])
}
